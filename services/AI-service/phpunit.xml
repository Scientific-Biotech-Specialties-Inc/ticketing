<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Tests must never touch the shared dev database (ticketing_system). -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <!-- The dev container runs with `config:cache` / `route:cache`. A cached config ignores the env
             values above, so tests point at their own (never written) cache files and always read
             this file's settings instead of the dev database config. -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing.php" force="true"/>
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/routes.testing.php" force="true"/>
        <!-- The container sets DB_CONNECTION=mysql / DB_DATABASE=ticketing_system as real environment
             variables, which land in $_SERVER. Laravel reads $_SERVER before $_ENV, and <env force>
             only writes $_ENV and putenv, so without these <server> lines tests ran against the shared
             dev database. tests/CreatesApplication.php refuses to start if that ever happens again. -->
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing.php" force="true"/>
        <server name="APP_ROUTES_CACHE" value="bootstrap/cache/routes.testing.php" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
