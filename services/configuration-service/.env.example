APP_NAME=ConfigurationService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8009

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ticketing_system
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

INTERNAL_TOKEN=

# Spec 0044: refuse customer tokens on traffic marked X-Ticketing-Edge: staff (true in Azure, unset locally)
TICKETING_EDGE_ENFORCE=false
# Spec 0044: shared Passport public key so customer tokens verify in every service
PASSPORT_PUBLIC_KEY=
