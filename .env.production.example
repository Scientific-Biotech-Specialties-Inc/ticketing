# ==============================================================================
# Enterprise Ticketing System - Production Environment Configuration Template
# Copy this file to .env on your production server or Azure deployment.
# ==============================================================================

# Application Environment
APP_ENV=production
APP_DEBUG=false

# MySQL Relational Database
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password_here
MYSQL_DATABASE=ticketing_prod

# MongoDB 7 NoSQL Database (Real-Time Messaging)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=your_secure_mongodb_password_here

# Google Gemini 2.0 Flash AI Service
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=15
KB_EMBEDDING_MODEL=gemini-embedding-001
KB_EMBEDDING_DIMS=768
KB_MIN_SCORE=0.55

# Inter-Service Cryptography & Authentication
# Generate a strong 64-character random string (e.g., via `openssl rand -hex 32`)
INTERNAL_TOKEN=generate_secure_random_internal_token_here
INTERNAL_SERVICE_SECRET=generate_secure_random_service_secret_here
AUTH_SERVICE_URL=http://auth-service:8000

# Laravel APP_KEY per service (required: containers refuse to start in production without one).
# Each key must stay the same across restarts and redeploys, or encrypted data (e.g. the
# configuration-service email credentials), sessions and queued jobs become unreadable.
# Queue workers and schedulers reuse their service's key. Generate each one separately with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# If a service already has a key in use, copy that existing key here instead of generating a new one.
CUSTOMER_SERVICE_APP_KEY=base64:generate_customer_service_key_here
TICKET_SERVICE_APP_KEY=base64:generate_ticket_service_key_here
EMPLOYEE_SERVICE_APP_KEY=base64:generate_employee_service_key_here
CONFIGURATION_SERVICE_APP_KEY=base64:generate_configuration_service_key_here
NOTIFICATION_SERVICE_APP_KEY=base64:generate_notification_service_key_here
ANALYTICS_SERVICE_APP_KEY=base64:generate_analytics_service_key_here
ATTACHMENT_SERVICE_APP_KEY=base64:generate_attachment_service_key_here
AI_SERVICE_APP_KEY=base64:generate_ai_service_key_here
MESSAGING_SERVICE_APP_KEY=base64:generate_messaging_service_key_here

# CORS: production browsers reach the APIs same origin through the portals' nginx, so no
# cross-origin access is allowed by default. If a separate origin ever needs it, add
# CORS_ALLOWED_ORIGINS (comma separated, exact origins, never '*') to that service's
# environment in docker-compose.prod.yml.

# Transactional Email Alerts (Brevo SMTP relay backup; primary sending uses the Brevo API key saved by the SuperAdmin)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_login
MAIL_PASSWORD=your_brevo_smtp_key_xsmtpsib
MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS must be a Brevo verified sender
MAIL_FROM_ADDRESS=support@organization.com
MAIL_FROM_NAME="Enterprise Ticketing System"

# Real-Time WebSocket Broadcasting (Customer Tickets & Notifications)
REVERB_APP_ID=ticketing_live
REVERB_APP_KEY=generate_random_key_here
REVERB_APP_SECRET=generate_random_secret_here

# Real-Time WebSocket Broadcasting (MongoDB Ticket Chat)
MESSAGING_REVERB_APP_ID=messaging_live
MESSAGING_REVERB_APP_KEY=generate_messaging_key_here
MESSAGING_REVERB_APP_SECRET=generate_messaging_secret_here
